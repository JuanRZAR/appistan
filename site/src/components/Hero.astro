---
import DownloadButton from './DownloadButton.astro';
import whatsapp from '../assets/apps/whatsapp.webp';
import facebook from '../assets/apps/facebook.webp';
import tiktok from '../assets/apps/tiktok.webp';
import messenger from '../assets/apps/messenger.webp';
import spotify from '../assets/apps/spotify.webp';
import netflix from '../assets/apps/netflix.webp';
interface Props { release: { version: string; artifact: string; sizeBytes: number; downloadUrl?: string } }
const { release } = Astro.props;
const apps = [{ name: 'WhatsApp', icon: whatsapp }, { name: 'Facebook', icon: facebook },
  { name: 'TikTok', icon: tiktok }, { name: 'Messenger', icon: messenger },
  { name: 'Spotify', icon: spotify }, { name: 'Netflix', icon: netflix }];
---
<section class="hero text-center" aria-labelledby="title">
  <img class="hero-icon" src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="104" height="104" fetchpriority="high" />
  <h1 id="title" class="mx-auto max-w-4xl text-[clamp(2.65rem,6.2vw,5.2rem)] leading-[1.06] font-black tracking-[-.045em]">Tus apps de siempre.<br />En una selección.</h1>
  <p class="mx-auto mt-6 mb-8 max-w-[35rem] text-base leading-relaxed text-muted sm:text-xl">Prepara tu nuevo Android sin ir de una descarga a otra. Elige tus aplicaciones y deja que AppIstan organice el resto.</p>
  <DownloadButton {...release} />
  <p class="mx-auto mt-3 max-w-80 text-xs leading-relaxed text-muted sm:max-w-none">Sin iniciar sesión en Google. Con las confirmaciones de Android.</p>
  <ul class="mt-9 flex flex-wrap items-center justify-center gap-3 sm:gap-4" aria-label="Algunas aplicaciones del catálogo">
    {apps.map(app => <li><img class="rounded-xl" src={app.icon.src} alt={app.name} width="40" height="40" title={app.name} /></li>)}
    <li class="ml-1 text-xs font-bold text-muted">y tus favoritas</li>
  </ul>
</section>
