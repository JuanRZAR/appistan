---
import preview from '../assets/app-preview.png';
---
<figure class="mx-auto mt-5 mb-18 max-w-[1000px] rounded-[20px] bg-soft p-2 sm:mb-28 sm:rounded-[32px] sm:p-4">
  <img class="block h-auto w-full rounded-xl border border-line sm:rounded-[20px]" src={preview.src} width={preview.width} height={preview.height} alt="Catálogo real de AppIstan: búsqueda, filtro Comunes, iconos oficiales y selección de aplicaciones" loading="lazy" decoding="async" />
  <figcaption class="px-2 pt-3 pb-1 text-center text-xs font-bold text-muted sm:text-sm">Un lugar para elegir. Una cola para instalar.</figcaption>
</figure>
