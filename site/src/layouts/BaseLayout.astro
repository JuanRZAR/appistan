---
import '../styles/global.css';
import fontUrl from '../assets/fonts/nunito.ttf?url';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#194e3b" />
    <meta name="description" content="Elige tus aplicaciones de Android, descarga todo el lote y confirma las instalaciones una tras otra. Descarga la última versión de AppIstan." />
    <title>AppIstan — Tus apps, en una selección</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="shell flex items-center justify-between gap-4 py-6 md:py-8" id="inicio">
      <a class="brand" href="#inicio" aria-label="AppIstan, inicio"><img src={`${base}favicon.svg`} alt="" width="38" height="38" />AppIstan</a>
      <span class="text-xs font-bold text-muted sm:text-sm">Hecha para Android</span>
    </header>
    <main class="shell" id="contenido"><slot /></main>
    <footer class="shell flex items-center justify-between gap-6 border-t border-line py-7">
      <a class="brand text-lg!" href="#inicio"><img src={`${base}favicon.svg`} alt="" width="28" height="28" />AppIstan</a>
      <p class="max-w-40 text-right text-xs text-muted sm:max-w-none sm:text-sm">Tu Android, listo para empezar.</p>
    </footer>
  </body>
</html>
